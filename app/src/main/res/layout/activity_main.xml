<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_canvas"
    android:orientation="vertical">

    <!-- Cabecera fija. El único acceso al perfil es esta fotografía. -->
    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="82dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/home_header_background">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/appHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="SOLO LEVELING" android:letterSpacing="0.17"
                android:textAllCaps="true" android:textSize="11sp"
                android:textStyle="bold" android:textColor="#CBC2EF" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="GYM BREAKER" android:textSize="25sp"
                android:textStyle="bold" android:textColor="#F8F4FF"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="SISTEMA DEL CAZADOR" android:textSize="10sp"
                android:letterSpacing="0.13" android:textColor="#ABA2CF"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/profileButton"
            android:layout_width="56dp" android:layout_height="56dp"
            android:padding="3dp" android:background="@drawable/home_avatar_border"
            android:contentDescription="Abrir mi perfil desde la fotografía"
            android:clickable="true" android:focusable="true"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/shadow_igris" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="18dp"
            android:paddingEnd="18dp" android:paddingTop="16dp" android:paddingBottom="22dp">
            <LinearLayout android:id="@+id/homeContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView android:id="@+id/pageTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="SISTEMA DEL CAZADOR" android:textColor="#F5F1FF"
                android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/pageSubtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                android:textColor="#BBB4D6" android:textSize="14sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="15dp"
                app:cardCornerRadius="19dp" app:cardBackgroundColor="#15112C"
                app:strokeColor="#8252CD" app:strokeWidth="1dp" >
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/home_panel_background"
                    android:padding="19dp">
                    <ImageView android:id="@+id/shadowPortrait" android:layout_width="90dp"
                        android:layout_height="90dp" android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp" android:contentDescription="Sombra acompañante"
                        android:scaleType="fitCenter" android:src="@drawable/shadow_beru"/>
                    <TextView android:id="@+id/heroTitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="21sp"
                        android:textColor="#FFFFFF" android:textStyle="bold"/>
                    <TextView android:id="@+id/heroDetail" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:textColor="#D1C9E7" android:textSize="14sp"/>
                    <ProgressBar android:id="@+id/xpBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="8dp"
                        android:layout_marginTop="16dp" android:max="100" android:progress="0"
                        android:progressTint="#A56CFF"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primaryAction" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="Acción principal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/secondaryCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="19dp"
                app:cardBackgroundColor="#15112C" app:strokeColor="#8252CD"
                app:strokeWidth="1dp" >
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/home_panel_background"
                    android:padding="19dp">
                    <TextView android:id="@+id/sectionTitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="19sp" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:id="@+id/sectionBody"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:textColor="#D1C9E7"
                        android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/secondaryAction"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:text="Acción secundaria" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/footer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:gravity="center" android:text="GYM BREAKER · SHADOW CORE OFFLINE"
                android:textColor="#9389B7" android:textSize="11sp" />
            <!-- Referencias internas a pantallas adicionales. Nunca hay aquí un botón Perfil. -->
            <LinearLayout android:visibility="gone" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/navShadows"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sombras"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/navAi"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IA"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/navSettings"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ajustes"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/navCatalog"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Catálogo"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Navegación inferior: Perfil deliberadamente excluido. -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent" android:layout_height="73dp"
        android:orientation="horizontal" android:gravity="center"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="7dp" android:paddingBottom="7dp"
        android:background="@drawable/home_bottom_background">
        <com.google.android.material.button.MaterialButton android:id="@+id/navSystem"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minWidth="0dp" android:insetTop="0dp"
            android:insetBottom="0dp" android:text="Inicio" android:textSize="11sp"
            android:gravity="center" android:padding="2dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/navTrain"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minWidth="0dp" android:insetTop="0dp"
            android:insetBottom="0dp" android:text="Rutinas" android:textSize="11sp"
            android:gravity="center" android:padding="2dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/navMissions"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minWidth="0dp" android:insetTop="0dp"
            android:insetBottom="0dp" android:text="Misiones" android:textSize="11sp"
            android:gravity="center" android:padding="2dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/navProgress"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minWidth="0dp" android:insetTop="0dp"
            android:insetBottom="0dp" android:text="Progreso" android:textSize="11sp"
            android:gravity="center" android:padding="2dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/navMore"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minWidth="0dp" android:insetTop="0dp"
            android:insetBottom="0dp" android:text="Más" android:textSize="11sp"
            android:gravity="center" android:padding="2dp"/>
    </LinearLayout>
</LinearLayout>